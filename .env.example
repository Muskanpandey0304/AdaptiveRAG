# Which LLM backend src/llm.py should use. Only "ollama" is implemented in this project.
LLM_PROVIDER=ollama

# Model name as known to that provider. For Ollama this must already be pulled locally
# (e.g. `ollama pull llama3.2:3b`).
LLM_MODEL=llama3.2:3b

# API key for the provider. Ollama runs locally and needs none, so this can stay empty.
API_KEY=
